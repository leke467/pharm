{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "preDeployCommand": "python manage.py migrate --noinput && python bootstrap_railway.py",
    "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:8000 --bind 0.0.0.0:8080 --workers 3 --threads 2 --timeout 120",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
